{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autonomy-corpus-v1.schema.json",
  "title": "Autonomy regression corpus manifest (autonomy-corpus/v1)",
  "description": "Documentation schema for the persisted autonomy regression corpus manifest. Describes the frozen set of evaluation cases and their independently reviewed oracles. Not executed by ajv; strict field lists must match docs/aut-05-baseline-runbook.md section 4.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "revision",
    "title",
    "createdAt",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "autonomy-corpus/v1"
      ]
    },
    "corpusId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "revision",
          "title",
          "failureFamily",
          "evaluationMode",
          "targetSystem",
          "sourceSnapshot",
          "goal",
          "canonicalInputs",
          "constraints",
          "inputArtifacts",
          "expectedOutcomeArtifacts",
          "oracle",
          "applicability",
          "assessment"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "failureFamily": {
            "type": "string",
            "enum": [
              "canonical_identity",
              "nested_manifest_contradiction",
              "producer_mismatch",
              "stale_review_continuation",
              "positive_control",
              "failed_incomplete_usage",
              "planning_baseline"
            ]
          },
          "evaluationMode": {
            "type": "string",
            "enum": [
              "offline_contract",
              "artifact_assessment",
              "historical_observation",
              "live_workflow"
            ]
          },
          "targetSystem": {
            "type": "string",
            "enum": [
              "harness",
              "target_orchestrator"
            ]
          },
          "sourceSnapshot": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "canonicalInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputArtifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "expectedOutcomeArtifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requiredOutcome",
              "forbiddenEffects",
              "acceptedEvidenceType",
              "sourceContract"
            ],
            "properties": {
              "requiredOutcome": {
                "type": "string"
              },
              "forbiddenEffects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptedEvidenceType": {
                "type": "string"
              },
              "sourceContract": {
                "type": "string"
              }
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "affectedByAutInterventions",
              "isRegressionControl"
            ],
            "properties": {
              "affectedByAutInterventions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isRegressionControl": {
                "type": "boolean"
              }
            }
          },
          "assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adapter",
              "supportedObservations",
              "knownLimitations"
            ],
            "properties": {
              "adapter": {
                "type": "string"
              },
              "supportedObservations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "knownLimitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
