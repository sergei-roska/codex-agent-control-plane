{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "delivery-v1.schema.json",
  "title": "Concurrent Harness delivery contracts v1",
  "description": "Versioned pure delivery record contract. Cross-record references, cycles and compare-and-swap revisions are additionally enforced by delivery-contracts.js.",
  "oneOf": [
    {
      "$ref": "#/definitions/objective"
    },
    {
      "$ref": "#/definitions/task"
    },
    {
      "$ref": "#/definitions/dependency"
    },
    {
      "$ref": "#/definitions/attempt"
    },
    {
      "$ref": "#/definitions/claim"
    },
    {
      "$ref": "#/definitions/event"
    },
    {
      "$ref": "#/definitions/candidate"
    },
    {
      "$ref": "#/definitions/receipt"
    },
    {
      "$ref": "#/definitions/planDelta"
    }
  ],
  "definitions": {
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 16000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "$ref": "#/definitions/jsonValue"
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "objectiveId",
        "predecessorType",
        "predecessorId",
        "successorTaskId",
        "kind"
      ],
      "properties": {
        "schemaVersion": {
          "const": "delivery/v1"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "objectiveId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "predecessorType": {
          "enum": [
            "task",
            "checkpoint"
          ]
        },
        "predecessorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "successorTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "kind": {
          "enum": [
            "requires_output",
            "requires_acceptance",
            "integration_after"
          ]
        },
        "expectedOutput": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "publicationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "granted",
            "denied",
            "unknown"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "authorityRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "readScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "paths"
          ],
          "properties": {
            "kind": {
              "const": "known"
            },
            "paths": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/path"
              }
            },
            "reason": {
              "type": "null"
